{"id":"tut-proc-012","tutorial":true,"nome":"Selo dos Quatro Cantos","categoria":"procedimento","dica":"Um canto so, chamado quatro vezes com posicoes diferentes.","par":55,"largura":32,"altura":32,"paleta":["transparente","#3BFF9E"],"pintados":68,"pixels":"1x9,0x14,1x10,0x30,1x2,0x30,1x2,0x30,1x2,0x30,1x2,0x30,1x2,0x30,1x2,0x30,1x2,0x30,1x1,0x448,1x1,0x30,1x2,0x30,1x2,0x30,1x2,0x30,1x2,0x30,1x2,0x30,1x2,0x30,1x2,0x30,1x10,0x14,1x9","codigoInicial":{"portugol":"programa {\n  funcao canto(inteiro ox, inteiro oy, inteiro dx, inteiro dy, inteiro cor) {\n    para (inteiro i = 0; i < 9; i++) {\n      pixel.ir_para(ox + i * dx, oy)\n      pixel.pintar(cor)\n      pixel.ir_para(ox, oy + i * dy)\n      pixel.pintar(cor)\n    }\n  }\n  funcao inicio() {\n    canto(0, 0, 1, 1, pixel.cor(59, 255, 158))\n    canto(31, 0, -1, 1, pixel.cor(59, 255, 158))\n    canto(0, 23, 1, -1, pixel.cor(59, 255, 158))\n    canto(31, 31, -1, -1, pixel.cor(59, 255, 158))\n  }\n}","blocos":{"blocks":{"languageVersion":0,"blocks":[{"type":"procedures_callnoreturn","extraState":{"name":"canto","params":["ox","oy","dx","dy","cor"]},"inputs":{"ARG0":{"block":{"type":"math_number","fields":{"NUM":0}}},"ARG1":{"block":{"type":"math_number","fields":{"NUM":0}}},"ARG2":{"block":{"type":"math_number","fields":{"NUM":1}}},"ARG3":{"block":{"type":"math_number","fields":{"NUM":1}}},"ARG4":{"block":{"type":"pixel_cor_rgb","inputs":{"R":{"block":{"type":"math_number","fields":{"NUM":59}}},"G":{"block":{"type":"math_number","fields":{"NUM":255}}},"B":{"block":{"type":"math_number","fields":{"NUM":158}}}}}}},"next":{"block":{"type":"procedures_callnoreturn","extraState":{"name":"canto","params":["ox","oy","dx","dy","cor"]},"inputs":{"ARG0":{"block":{"type":"math_number","fields":{"NUM":31}}},"ARG1":{"block":{"type":"math_number","fields":{"NUM":0}}},"ARG2":{"block":{"type":"math_arithmetic","fields":{"OP":"MINUS"},"inputs":{"A":{"shadow":{"type":"math_number","fields":{"NUM":0}}},"B":{"block":{"type":"math_number